{
  "name": "guest-connect-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:production": "tsc -b && vite build",
    "build": "tsc -b && vite build --mode staging",
    "build:development": "tsc -b && vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
